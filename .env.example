# Database. Dev uses SQLite. For production change `provider` in prisma/schema.prisma to "postgresql"
# and use e.g. postgresql://user:pass@localhost:5432/nivo
DATABASE_URL="file:./dev.db"

# Long random string used to sign session cookies (openssl rand -base64 48)
AUTH_SECRET="change-me-to-a-long-random-string"

# Public site URL (used for sitemap / metadata)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Where receipts are stored (outside the public folder)
STORAGE_DIR="./storage"

# Initial admin created by the seed script
ADMIN_EMAIL="admin@nivo.local"
ADMIN_PASSWORD="ChangeMe123!"
